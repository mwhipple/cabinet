#!/usr/bin/env python3

# Parse a log from Al and return aggregated time spent between messages,
# grouped by role.

import re
import sys
from datetime import datetime
from collections import defaultdict

def parse_line(line):
    ts_match = re.match(r"^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2},\d+)", line)
    if not ts_match:
        return None
    ts_str = ts_match.group(1)
    ts = datetime.strptime(ts_str, "%Y-%m-%d %H:%M:%S,%f")
    role_match = re.search(r"'role': '([^']+)'", line)
    if not role_match:
        return None
    role = role_match.group(1)
    return (ts, role)

with open(sys.argv[1], "r") as f:
    all_parsed = [parse_line(line) for line in f]
parsed = [item for item in all_parsed if item is not None]

prev_ts = None
prev_role = None
totals = defaultdict(float)
for ts, role in parsed:
    if prev_role is not None:
        delta = (ts - prev_ts).total_seconds()
        totals[(prev_role, role)] += delta
    prev_ts = ts
    prev_role = role

for (r1, r2), dur in sorted(totals.items()):
    print(f"{r1}->{r2}: {dur:.3f}s")
